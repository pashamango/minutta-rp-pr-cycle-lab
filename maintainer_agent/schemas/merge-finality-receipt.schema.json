{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mindrock.example/schemas/async-merge-finality-receipt-v1.json",
  "title": "ASYNC_MERGE_FINALITY_RECEIPT/v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version", "repository", "pr_number", "expected_head_sha",
    "request_id", "operation_state", "artifact_state", "observed_at"
  ],
  "properties": {
    "version": {"const": "ASYNC_MERGE_FINALITY_RECEIPT/v1"},
    "repository": {"type": "string"},
    "pr_number": {"type": "integer", "minimum": 1},
    "expected_head_sha": {"type": "string", "pattern": "^[0-9a-f]{40,64}$"},
    "request_id": {"type": "string", "minLength": 1},
    "operation_state": {"enum": ["PENDING", "MERGED", "ENQUEUED", "FAILED", "EXPIRED", "UNKNOWN"]},
    "artifact_state": {"enum": ["UNMERGED", "MERGED", "CONFLICTED", "UNKNOWN"]},
    "merge_oid": {"type": ["string", "null"]},
    "observed_base_head_sha": {"type": ["string", "null"]},
    "observed_at": {"type": "string", "format": "date-time"}
  }
}
