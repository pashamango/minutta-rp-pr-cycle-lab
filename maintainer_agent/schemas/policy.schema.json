{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mindrock.example/schemas/maintainer-policy-v1.json",
  "title": "MAINTAINER_POLICY/v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version", "enabled", "repository", "base_branches",
    "autonomous_ceiling", "protected_paths", "risk_rules"
  ],
  "properties": {
    "version": {"const": "MAINTAINER_POLICY/v1"},
    "enabled": {"type": "boolean"},
    "repository": {"type": "string", "pattern": "^[^/]+/[^/]+$"},
    "base_branches": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "autonomous_ceiling": {"enum": ["R0", "R1", "R2"]},
    "protected_paths": {"type": "array", "items": {"type": "string"}},
    "risk_rules": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["pattern", "risk_class"],
        "properties": {
          "pattern": {"type": "string"},
          "risk_class": {"enum": ["R0", "R1", "R2", "R3"]}
        }
      }
    }
  }
}
