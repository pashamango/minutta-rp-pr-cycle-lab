                for r in res["rejection_reasons"]:
                    print(f"  - ❌ {r}")
            m = res["metrics"]
            print(f"Baseline External Tokens:     {m['baseline_external_tokens']}")
            print(f"Local FORGE Tokens:           {m['local_forge_tokens_generated']}")
            print(f"Tests Passed:                 {m['tests_passed']}")
            print(f"Review Minutes:               {m['human_review_minutes']}")
            print(f"False DONE Claims:            {m['false_done_claims']}")
            print(f"Tokens/Review Minute:         {m['net_tokens_saved_per_review_minute']}")

        if not res["valid"]:
