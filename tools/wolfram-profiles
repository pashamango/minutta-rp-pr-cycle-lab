@dataclasses.dataclass
class HostCapacityProbe:
    total_ram_bytes: int
    total_ram_gib: float
    swap_total_mib: float
    swap_used_mib: float
    swap_free_mib: float
    memory_free_percent: float
    page_size_bytes: int
    pages_free: int
    pages_active: int
    pages_inactive: int
    pages_wired: int
    pages_compressed: int
    pageins: int
    pageouts: int
    swapins: int
    swapouts: int
    timestamp_utc: str

    def to_dict(self) -> Dict[str, Any]:
        return dataclasses.asdict(self)


def parse_sysctl_memsize(output: str) -> int:
    match = re.search(r"(\d+)", output)
    if not match:
        raise ValueError(f"Unable to parse memsize from output: {output!r}")
    return int(match.group(1))


def parse_swapusage(output: str) -> Tuple[float, float, float]:
    """Parses sysctl vm.swapusage output.
    Format: total = 14336.00M  used = 12820.06M  free = 1515.94M
    """
    total_m = re.search(r"total\s*=\s*([\d\.]+)M", output)
    used_m = re.search(r"used\s*=\s*([\d\.]+)M", output)
    free_m = re.search(r"free\s*=\s*([\d\.]+)M", output)
    if not (total_m and used_m and free_m):
        raise ValueError(f"Unable to parse vm.swapusage: {output!r}")
    return float(total_m.group(1)), float(used_m.group(1)), float(free_m.group(1))


def parse_memory_pressure(output: str) -> float:
    """Parses memory_pressure output for free percentage."""
    match = re.search(r"System-wide memory free percentage:\s*(\d+)%", output)
    if match:
        return float(match.group(1))
    # Fallback to estimation from percentage
    match_est = re.search(r"(\d+)%", output)
    if match_est:
        return float(match_est.group(1))
    return 50.0


def parse_vm_stat(output: str) -> Dict[str, int]:
    """Parses vm_stat output into dictionary of counts."""
    stats: Dict[str, int] = {}
    for line in output.splitlines():
        line = line.strip()
        if not line or line.startswith("Mach"):
            continue
        parts = line.split(":")
        if len(parts) == 2:
            key = parts[0].strip().strip('"')
            val_match = re.search(r"(\d+)", parts[1].replace(".", ""))
            if val_match:
                stats[key] = int(val_match.group(1))
    return stats


def sample_host_capacity(
    sysctl_mem_raw: Optional[str] = None,
    sysctl_swap_raw: Optional[str] = None,
    memory_pressure_raw: Optional[str] = None,
    vm_stat_raw: Optional[str] = None,
) -> HostCapacityProbe:
    """Samples host capacity metrics using system commands or provided raw strings."""
    import datetime as dt

    # 1. Total RAM
    if sysctl_mem_raw is None:
        sysctl_mem_raw = subprocess.check_output(
            ["sysctl", "-n", "hw.memsize"], text=True
        )
    ram_bytes = parse_sysctl_memsize(sysctl_mem_raw)
    ram_gib = round(ram_bytes / (1024**3), 2)

    # 2. Swap
    if sysctl_swap_raw is None:
        sysctl_swap_raw = subprocess.check_output(
            ["sysctl", "-n", "vm.swapusage"], text=True
        )
    swap_total, swap_used, swap_free = parse_swapusage(sysctl_swap_raw)

    # 3. Memory pressure
    if memory_pressure_raw is None:
        try:
            memory_pressure_raw = subprocess.check_output(
                ["memory_pressure"], text=True, stderr=subprocess.DEVNULL
            )
        except Exception:
            memory_pressure_raw = "System-wide memory free percentage: 50%"
    mem_free_pct = parse_memory_pressure(memory_pressure_raw)

    # 4. vm_stat
    if vm_stat_raw is None:
        try:
            vm_stat_raw = subprocess.check_output(["vm_stat"], text=True)
        except Exception:
            vm_stat_raw = ""
    vm_stats = parse_vm_stat(vm_stat_raw)

    page_size = 16384  # Standard on Apple Silicon arm64 macOS
    pages_free = vm_stats.get("Pages free", 0)
    pages_active = vm_stats.get("Pages active", 0)
    pages_inactive = vm_stats.get("Pages inactive", 0)
    pages_wired = vm_stats.get("Pages wired down", 0)
    pages_compressed = vm_stats.get("Pages stored in compressor", 0)
    pageins = vm_stats.get("Pageins", 0)
    pageouts = vm_stats.get("Pageouts", 0)
    swapins = vm_stats.get("Swapins", 0)
    swapouts = vm_stats.get("Swapouts", 0)

    ts = dt.datetime.now(dt.timezone.utc).isoformat().replace("+00:00", "Z")

    return HostCapacityProbe(
        total_ram_bytes=ram_bytes,
        total_ram_gib=ram_gib,
        swap_total_mib=swap_total,
        swap_used_mib=swap_used,
        swap_free_mib=swap_free,
        memory_free_percent=mem_free_pct,
        page_size_bytes=page_size,
        pages_free=pages_free,
        pages_active=pages_active,
        pages_inactive=pages_inactive,
        pages_wired=pages_wired,
        pages_compressed=pages_compressed,
        pageins=pageins,
        pageouts=pageouts,
        swapins=swapins,
        swapouts=swapouts,
        timestamp_utc=ts,
    )


def plan_profile_transition(
    target_profile: str,
    current_profile: str = "GUARD",
    probe: Optional[HostCapacityProbe] = None,
    active_processes: Optional[List[str]] = None,
) -> Dict[str, Any]:
    """Generates a safe, read-only plan for transitioning to target_profile.
    Validates mutual exclusion (FORGE xor MATH), headroom, and protected daemons.
    """
    if target_profile not in PROFILES:
        raise ValueError(
            f"Invalid target profile: {target_profile}. Must be one of {PROFILES}"
        )
    if current_profile not in PROFILES:
        raise ValueError(f"Invalid current profile: {current_profile}")

    if probe is None:
        probe = sample_host_capacity()

    spec = PROFILE_SPECS[target_profile]
    actions_to_stop: List[str] = []
    actions_to_start: List[str] = []
    safety_violations: List[str] = []
    warnings: List[str] = []

    # 1. Capacity check: Memory Free Percentage
    if probe.memory_free_percent < THRESHOLDS["min_free_memory_percent"]:
        safety_violations.append(
            f"System memory free percentage ({probe.memory_free_percent:.1f}%) "
            f"is below safe threshold ({THRESHOLDS['min_free_memory_percent']:.1f}%)."
        )

    # 2. Swap headroom check
    if probe.swap_used_mib > THRESHOLDS["max_allowed_swap_used_mib"]:
        safety_violations.append(
            f"Swap usage ({probe.swap_used_mib:.1f} MiB) exceeds safety ceiling "
            f"({THRESHOLDS['max_allowed_swap_used_mib']:.1f} MiB)."
        )

    # 3. Mutual exclusivity enforcement (FORGE xor MATH)
    if target_profile == "FORGE":
        if current_profile == "MATH":
            actions_to_stop.append("MATH formal solver / Lean4 compiler sessions")
        actions_to_start.append("Local Ollama single model harness (3B-8B quantized, max_parallel=1)")
    elif target_profile == "MATH":
        if current_profile == "FORGE":
            actions_to_stop.append("Local Ollama loaded generator models")
        actions_to_start.append("Lean4 / Rust proof check session")
    elif target_profile == "GUARD":
        if current_profile == "FORGE":
            actions_to_stop.append("Local Ollama loaded generator models")
        if current_profile == "MATH":
            actions_to_stop.append("MATH formal solver / Lean4 compiler sessions")

    # 4. Check protected processes (they must NEVER be in actions_to_stop)
    for protected in PROTECTED_PROCESSES:
        for action in actions_to_stop:
            if protected.lower() in action.lower():
                safety_violations.append(
                    f"CRITICAL SAFETY VIOLATION: Planned action '{action}' targets protected service '{protected}'!"
                )

    # 5. Resident swap note (High resident swap != continued swap growth)
    if probe.swap_used_mib > 8000:
        warnings.append(
            f"High resident swap observed ({probe.swap_used_mib:.1f} MiB). "
            "Note: macOS arm64 resident swap is retained by design; verify swap growth delta over 5m window before aborting."
        )

    is_admissible = len(safety_violations) == 0

    return {
        "protocol": PROTOCOL,
        "current_profile": current_profile,
        "target_profile": target_profile,
        "spec": spec,
        "admissible": is_admissible,
        "violations": safety_violations,
        "warnings": warnings,
        "actions_to_stop": actions_to_stop,
        "actions_to_start": actions_to_start,
        "protected_services_preserved": list(PROTECTED_PROCESSES),
        "capacity_probe": probe.to_dict(),
        "thresholds": THRESHOLDS,
    }


def evaluate_falsifiable_benefit(
    task_id: str,
    baseline_external_tokens: int,
    local_forge_tokens_generated: int,
    tests_passed: bool,
    proof_certified: bool,
    human_review_minutes: float,
    false_done_claims: int,
    wall_clock_seconds: float,
    estimated_external_savings_cents: float,
) -> Dict[str, Any]:
    """Calculates falsifiable benefit metrics comparing local FORGE vs external workflow.
    Rule: Never equate local task count with monetary savings or correctness.
    Zero false DONE claims is mandatory for admissibility.
    """
    valid = True
    rejection_reasons: List[str] = []

    if false_done_claims > 0:
        valid = False
        rejection_reasons.append(
            f"FALSE_DONE_DETECTED: {false_done_claims} false completion claims reported. Rejection mandatory."
        )

    if not tests_passed:
        valid = False
        rejection_reasons.append("TESTS_FAILED: Scaffolding or code did not pass validated unit tests.")

    # Net efficiency score: external tokens saved per human review minute
    net_token_efficiency = 0.0
    if human_review_minutes > 0:
        net_token_efficiency = round(baseline_external_tokens / human_review_minutes, 2)

    return {
        "task_id": task_id,
        "valid": valid,
        "admissible_for_token_substitution": valid and (baseline_external_tokens > 0),
        "rejection_reasons": rejection_reasons,
        "metrics": {
            "baseline_external_tokens": baseline_external_tokens,
            "local_forge_tokens_generated": local_forge_tokens_generated,
            "tests_passed": tests_passed,
            "proof_certified": proof_certified,
            "human_review_minutes": human_review_minutes,
            "false_done_claims": false_done_claims,
            "wall_clock_seconds": wall_clock_seconds,
            "estimated_external_savings_cents": estimated_external_savings_cents,
            "net_tokens_saved_per_review_minute": net_token_efficiency,
        },
    }


