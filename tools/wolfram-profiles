    args = parser.parse_args()

    if args.subcommand == "probe":
        probe = sample_host_capacity()
        if args.json:
            print(json.dumps(probe.to_dict(), indent=2))
        else:
            print(f"=== Wolfram Capacity Probe ({probe.timestamp_utc}) ===")
            print(f"RAM Total:          {probe.total_ram_gib:.2f} GiB")
            print(f"Memory Free:        {probe.memory_free_percent:.1f}%")
            print(f"Swap Used / Total:  {probe.swap_used_mib:.1f} / {probe.swap_total_mib:.1f} MiB")
            print(f"Pageins / Pageouts: {probe.pageins} / {probe.pageouts}")
            print(f"Swapins / Swapouts: {probe.swapins} / {probe.swapouts}")
            print(f"Compressed Pages:   {probe.pages_compressed}")

    elif args.subcommand == "plan":
        probe = sample_host_capacity()
        plan = plan_profile_transition(
            target_profile=args.target,
            current_profile=args.current,
            probe=probe,
        )
        if args.json:
            print(json.dumps(plan, indent=2))
        else:
            print(f"=== Profile Plan: {args.current} -> {args.target} ===")
            print(f"Admissible: {plan['admissible']}")
            if plan["violations"]:
                print("Violations:")
                for v in plan["violations"]:
                    print(f"  - ❌ {v}")
            if plan["warnings"]:
                print("Warnings:")
                for w in plan["warnings"]:
                    print(f"  - ⚠️  {w}")
            print("Actions to stop:")
            for s in plan["actions_to_stop"] or ["(none)"]:
                print(f"  - {s}")
            print("Actions to start:")
            for a in plan["actions_to_start"] or ["(none)"]:
                print(f"  - {a}")
            print("Protected daemons preserved:")
            for p in plan["protected_services_preserved"]:
                print(f"  - 🛡️  {p}")

        if not plan["admissible"]:
            sys.exit(1)

    elif args.subcommand == "evaluate":
        res = evaluate_falsifiable_benefit(
            task_id=args.task,
            baseline_external_tokens=args.baseline_tokens,
            local_forge_tokens_generated=args.forge_tokens,
            tests_passed=args.tests_passed,
            proof_certified=args.proof_certified,
            human_review_minutes=args.review_minutes,
            false_done_claims=args.false_dones,
            wall_clock_seconds=args.wall_seconds,
            estimated_external_savings_cents=args.savings_cents,
        )
        if args.json:
            print(json.dumps(res, indent=2))
        else:
            print(f"=== Falsifiable Benefit Evaluation: {args.task} ===")
            print(f"Valid:                        {res['valid']}")
            print(f"Admissible for Substitution:  {res['admissible_for_token_substitution']}")
            if res["rejection_reasons"]:
