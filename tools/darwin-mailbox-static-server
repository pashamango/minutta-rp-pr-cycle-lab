#!/usr/bin/env python3
"""Installed static-only HTTP preview: fixed IPv4 loopback; no CGI or directory listing."""
from http.server import SimpleHTTPRequestHandler, ThreadingHTTPServer
from pathlib import Path
import os
import sys
from urllib.parse import unquote, urlsplit

class Handler(SimpleHTTPRequestHandler):
    def list_directory(self, path):
        self.send_error(403)
        return None

    def send_head(self):
        root = Path.cwd().resolve()
        target = (root / unquote(urlsplit(self.path).path).lstrip('/')).resolve()
        if target != root and root not in target.parents:
            self.send_error(403)
            return None
        return super().send_head()

    def log_message(self, *args):
        pass

if __name__ == '__main__':
    root, port = Path(sys.argv[1]), int(sys.argv[2])
    if os.getuid() == 0 or not 1024 <= port <= 65535 or root.is_symlink():
        raise SystemExit('invalid preview scope')
    os.chdir(root)
    ThreadingHTTPServer(('127.0.0.1', port), Handler).serve_forever()
