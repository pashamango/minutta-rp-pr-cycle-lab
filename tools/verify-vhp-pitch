# --- Fraction-Pair Wheel Arithmetic Engine ---

class WheelFraction:
    def __init__(self, n, d):
        self.n = int(n)
        self.d = int(d)
        self.canonicalize()

    def canonicalize(self):
        if self.n == 0 and self.d == 0:
            self.n, self.d = 0, 0
            return
        if self.d == 0:
            self.n, self.d = 1, 0
            return
        if self.n == 0:
            self.n, self.d = 0, 1
            return
        g = math.gcd(abs(self.n), abs(self.d))
        self.n //= g
        self.d //= g
        if self.d < 0:
            self.n = -self.n
            self.d = -self.d

    def __add__(self, other):
        n = self.n * other.d + other.n * self.d
        d = self.d * other.d
        return WheelFraction(n, d)

    def __sub__(self, other):
        n = self.n * other.d - other.n * self.d
        d = self.d * other.d
        return WheelFraction(n, d)

    def __mul__(self, other):
        n = self.n * other.n
        d = self.d * other.d
        return WheelFraction(n, d)

    def recip(self):
        return WheelFraction(self.d, self.n)

    def __eq__(self, other):
        if not isinstance(other, WheelFraction):
            return False
        return (self.n == other.n) and (self.d == other.d)

    def is_bottom(self):
        return self.n == 0 and self.d == 0

    def is_infinity(self):
        return self.n != 0 and self.d == 0

    def is_zero(self):
        return self.n == 0 and self.d != 0

    def __repr__(self):
        if self.is_bottom():
            return "⊥ (0/0)"
        elif self.is_infinity():
            return "∞ (1/0)"
        else:
            return f"{self.n}/{self.d}"


def verify_wheel_axioms():
    """
    Empirically verifies the 8 Carlström Wheel Algebra properties on a 7-element representative
    sample domain [0, 1, -1, 2/3, -5/7, ∞ (1/0), ⊥ (0/0)], testing 1,190 evaluations
    (including 343 triples for each ternary property).
    """
    samples = [
        WheelFraction(0, 1),   # 0
        WheelFraction(1, 1),   # 1
        WheelFraction(-1, 1),  # -1
        WheelFraction(2, 3),   # 2/3
        WheelFraction(-5, 7),  # -5/7
        WheelFraction(1, 0),   # ∞ (1/0)
        WheelFraction(0, 0),   # ⊥ (0/0)
    ]
    zero = WheelFraction(0, 1)

    eval_count = 0

    # 1. AXM-W01: Addition Commutativity: x + y = y + x (7x7 = 49 pairs)
    for x in samples:
        for y in samples:
            eval_count += 1
            if (x + y) != (y + x):
                return False, f"AXM-W01 (add_comm) failed for x={x}, y={y}", eval_count

    # 2. AXM-W02: Addition Associativity: (x + y) + z = x + (y + z) (7x7x7 = 343 triples across all samples)
    for x in samples:
        for y in samples:
            for z in samples:
                eval_count += 1
                if ((x + y) + z) != (x + (y + z)):
                    return False, f"AXM-W02 (add_assoc) failed for x={x}, y={y}, z={z}", eval_count

    # 3. AXM-W03: Multiplication Commutativity: x * y = y * x (7x7 = 49 pairs)
    for x in samples:
        for y in samples:
            eval_count += 1
            if (x * y) != (y * x):
                return False, f"AXM-W03 (mul_comm) failed for x={x}, y={y}", eval_count

    # 4. AXM-W04: Multiplication Associativity: (x * y) * z = x * (y * z) (7x7x7 = 343 triples across all samples)
    for x in samples:
        for y in samples:
            for z in samples:
                eval_count += 1
                if ((x * y) * z) != (x * (y * z)):
                    return False, f"AXM-W04 (mul_assoc) failed for x={x}, y={y}, z={z}", eval_count

    # 5. AXM-W05: Reciprocal Involution: /( /x ) = x (7 elements)
    for x in samples:
        eval_count += 1
        if x.recip().recip() != x:
            return False, f"AXM-W05 (recip_invol) failed for x={x}", eval_count

    # 6. AXM-W06: Product Reciprocal: /(x * y) = /x * /y (7x7 = 49 pairs)
    for x in samples:
        for y in samples:
            eval_count += 1
            if (x * y).recip() != (x.recip() * y.recip()):
                return False, f"AXM-W06 (recip_mul) failed for x={x}, y={y}", eval_count

    # 7. AXM-W07: Regularized Distributivity: (x + y)*z + 0*z = x*z + y*z (7x7x7 = 343 triples across all samples)
    for x in samples:
        for y in samples:
            for z in samples:
                eval_count += 1
                lhs = ((x + y) * z) + (zero * z)
                rhs = (x * z) + (y * z)
                if lhs != rhs:
                    return False, f"AXM-W07 (distrib_reg) failed for x={x}, y={y}, z={z}", eval_count

    # 8. AXM-W08: Negation Regularization: x - x = 0 * x (7 elements)
    for x in samples:
        eval_count += 1
        if (x - x) != (zero * x):
            return False, f"AXM-W08 (neg_reg) failed for x={x}", eval_count

    return True, f"8/8 Carlström wheel properties verified on 7-element representative domain ({eval_count} sample checks)", eval_count


def audit_verifier_ast(script_path: Path):
    """
    Performs static AST analysis on the verification engine script to ensure:
    - verify_wheel_axioms function exists in AST.
    - All 8 axiom codes (AXM-W01 through AXM-W08) are present in string literals.
    - No 'pass', 'NotImplemented', or empty placeholder stubs exist in verify_wheel_axioms.
    - Comparison expressions exist for all 8 properties.
    """
    try:
        source = script_path.read_text(encoding="utf-8")
        tree = ast.parse(source, filename=str(script_path))
    except Exception as e:
        return False, f"AST parsing failed: {e}", {}

    target_func = None
    for node in ast.walk(tree):
        if isinstance(node, ast.FunctionDef) and node.name == "verify_wheel_axioms":
            target_func = node
            break

    if not target_func:
        return False, "AST Auditor: function 'verify_wheel_axioms' not found in AST", {}

    # Check for empty / pass stubs inside verify_wheel_axioms
    pass_nodes = [n for n in ast.walk(target_func) if isinstance(n, ast.Pass)]
    if pass_nodes:
        return False, f"AST Auditor: unreviewed stub ('pass') detected in verify_wheel_axioms at line {pass_nodes[0].lineno}", {}

    # Check that comparison operations exist
    compares = [n for n in ast.walk(target_func) if isinstance(n, ast.Compare)]
    if len(compares) < 8:
        return False, f"AST Auditor: insufficient comparison operations in verify_wheel_axioms ({len(compares)} < 8)", {}

    # Extract all string constants to verify all 8 axiom IDs are explicitly handled
    strings = [n.value for n in ast.walk(target_func) if isinstance(n, ast.Constant) and isinstance(n.value, str)]
    full_text = " ".join(strings)
    expected_axioms = [f"AXM-W0{i}" for i in range(1, 9)]
    missing = [ax for ax in expected_axioms if ax not in full_text]
    if missing:
        return False, f"AST Auditor: missing explicit handlers for axioms: {missing}", {}

    return True, f"AST Audit passed: verified 8/8 axiom AST handler nodes, {len(compares)} comparison assertions, 0 stubbed pass nodes", {
        "axiom_count": 8,
        "comparison_nodes": len(compares),
        "unreviewed_stubs": 0
    }


def get_git_head_sha(root_dir: Path):
    try:
        res = subprocess.run(
            ["git", "rev-parse", "HEAD"],
            cwd=str(root_dir),
            capture_output=True,
            text=True,
            timeout=5
        )
        if res.returncode == 0:
            return res.stdout.strip()
    except Exception:
        pass
    return None


OUTDATED_REJECTED_SHAS = {
    "511565cc3c68e51ad616726579b9f613399038cd",  # Rejected baseline lacking full 7-element audit and AST auditor
    "71d669674f9b47b7be6395913b6e5fc88edb4739",  # Outdated ancestor containing bypass mechanisms and mismatched pitch
}


def verify_receipt_commit(receipt_commit: str, root_dir: Path, expected_commit: str = None):
    head_sha = get_git_head_sha(root_dir)
    if not head_sha:
        return True, "Not inside a valid git repository; commit match check skipped."

    if receipt_commit == "HEAD":
        return False, "Receipt commit 'HEAD' is mutable and non-tamper-evident; exact immutable 40-character hex commit SHA required."

    if not re.fullmatch(r"[0-9a-fA-F]{40}", receipt_commit):
        return False, f"Receipt commit '{receipt_commit}' is not a valid 40-character hex SHA"

    if receipt_commit in OUTDATED_REJECTED_SHAS:
        return False, f"Receipt commit '{receipt_commit}' is a known outdated/rejected baseline or ancestor commit."

    if expected_commit:
        if receipt_commit != expected_commit:
            return False, f"Receipt commit '{receipt_commit}' does not match expected audited commit '{expected_commit}'"

    if receipt_commit == head_sha:
        return True, f"Receipt commit '{receipt_commit}' strictly matches checkout HEAD ({head_sha})"

    # Allow receipt_commit if it matches the audited target commit (direct parent HEAD^)
    try:
        res = subprocess.run(
            ["git", "rev-parse", "HEAD^"],
            cwd=str(root_dir),
            capture_output=True,
            text=True,
            timeout=5
        )
        if res.returncode == 0 and res.stdout.strip() == receipt_commit:
            return True, f"Receipt commit '{receipt_commit}' strictly matches audited target commit (parent HEAD^ of {head_sha})"
    except Exception:
        pass

    return False, f"Receipt commit '{receipt_commit}' does not match checked out HEAD ({head_sha}) or audited target commit (parent HEAD^)"


def verify_audited_commit_tree(audited_commit: str, receipt_data: dict, root_dir: Path):
    """
    Verifies that the pinned audited commit tree contains all target artifacts with
    matching SHA-256 hashes, and that the verifier script inside the audited commit
    contains NO forbidden bypass mechanisms (CANONICAL_TARGET_SHAS, cat-file)
    and passes static AST auditing.
    """
    issues = []
    log = []

    if not audited_commit or not re.fullmatch(r"[0-9a-fA-F]{40}", audited_commit):
        return False, f"Invalid audited commit SHA: '{audited_commit}'", [f"Invalid audited commit SHA: '{audited_commit}'"]

    if audited_commit in OUTDATED_REJECTED_SHAS:
        return False, f"Audited commit '{audited_commit}' is a known outdated/rejected baseline.", [f"Audited commit '{audited_commit}' is in OUTDATED_REJECTED_SHAS"]

    # Verify commit exists in git
    res = subprocess.run(
        ["git", "rev-parse", "--verify", f"{audited_commit}^{{commit}}"],
        cwd=str(root_dir),
        capture_output=True,
        text=True
    )
    if res.returncode != 0:
        return False, f"Audited commit '{audited_commit}' not found in repository", [f"Audited commit '{audited_commit}' not found in git history"]

    target_artifacts = receipt_data.get("audited_tree_artifacts") or receipt_data.get("audited_target_artifacts") or receipt_data.get("target_artifacts", {})
    if not target_artifacts:
        issues.append("Receipt does not contain 'audited_tree_artifacts' or 'target_artifacts' dictionary")

    for art_name, art_info in target_artifacts.items():
        rel_path = art_info.get("path")
        expected_sha = art_info.get("sha256")
        if not rel_path or not expected_sha:
            issues.append(f"Artifact '{art_name}' missing path or sha256 in receipt")
            continue

        res_art = subprocess.run(
            ["git", "show", f"{audited_commit}:{rel_path}"],
            cwd=str(root_dir),
            capture_output=True,
            text=True
        )
        if res_art.returncode != 0:
            issues.append(f"Audited commit '{audited_commit[:8]}' is missing artifact '{rel_path}'")
            continue

        actual_sha = hashlib.sha256(res_art.stdout.encode("utf-8")).hexdigest()
        if actual_sha != expected_sha:
            issues.append(
                f"Audited commit '{audited_commit[:8]}' artifact '{rel_path}' SHA-256 mismatch: "
                f"expected {expected_sha}, got {actual_sha}"
            )
        else:
            log.append(f"Audited commit '{audited_commit[:8]}' artifact '{rel_path}' SHA-256 verified ({actual_sha[:16]}...)")

    # Verify verifier in audited commit
    res_v = subprocess.run(
        ["git", "show", f"{audited_commit}:tools/verify-vhp-pitch"],
        cwd=str(root_dir),
        capture_output=True,
        text=True
    )
    if res_v.returncode != 0:
        issues.append(f"Audited commit '{audited_commit[:8]}' is missing tools/verify-vhp-pitch")
    else:
        verifier_source = res_v.stdout
        if "CANONICAL_TARGET_SHAS" in verifier_source:
            issues.append(f"Audited commit '{audited_commit[:8]}' verifier contains forbidden bypass 'CANONICAL_TARGET_SHAS'")
        if "cat-file" in verifier_source:
            issues.append(f"Audited commit '{audited_commit[:8]}' verifier contains forbidden bypass 'cat-file'")

        # AST audit on audited verifier
        try:
            tree = ast.parse(verifier_source)
            target_func = next((n for n in ast.walk(tree) if isinstance(n, ast.FunctionDef) and n.name == "verify_wheel_axioms"), None)
            if not target_func:
                issues.append(f"Audited commit '{audited_commit[:8]}' verifier missing 'verify_wheel_axioms' function in AST")
            else:
                pass_nodes = [n for n in ast.walk(target_func) if isinstance(n, ast.Pass)]
                if pass_nodes:
                    issues.append(f"Audited commit '{audited_commit[:8]}' verifier has unreviewed pass stub in verify_wheel_axioms")
                compares = [n for n in ast.walk(target_func) if isinstance(n, ast.Compare)]
                if len(compares) < 8:
                    issues.append(f"Audited commit '{audited_commit[:8]}' verifier has insufficient comparisons ({len(compares)} < 8)")
                strings = [n.value for n in ast.walk(target_func) if isinstance(n, ast.Constant) and isinstance(n.value, str)]
                full_text = " ".join(strings)
                expected_axioms = [f"AXM-W0{i}" for i in range(1, 9)]
                missing_axioms = [ax for ax in expected_axioms if ax not in full_text]
                if missing_axioms:
                    issues.append(f"Audited commit '{audited_commit[:8]}' verifier missing axiom handlers: {missing_axioms}")
                if not any("AST" in iss for iss in issues):
                    log.append(f"Audited commit '{audited_commit[:8]}' verifier AST audit passed (8 axioms, 0 stubs, no bypasses)")
        except Exception as e:
            issues.append(f"Audited commit '{audited_commit[:8]}' verifier AST parsing failed: {e}")

    if issues:
        return False, f"Audited commit tree verification failed with {len(issues)} issue(s)", issues
    return True, f"Audited commit '{audited_commit[:8]}' tree strictly verified across all target artifacts and clean verifier", log


def normalize_pitch_text(text: str) -> str:
    t = text.replace(r"$\mathbb{W}(\mathbb{Q})$", "W(Q)")
    t = t.replace(r"\mathbb{W}(\mathbb{Q})", "W(Q)")
    t = t.replace(r"\infty", "∞")
    t = t.replace(r"\bot", "⊥")
    t = t.replace("$", "")
    return t.strip()


def validate_pitch_schema(data: dict, schema: dict):
    # Try jsonschema library first if available
    try:
        import jsonschema
        jsonschema.validate(instance=data, schema=schema)
    except ImportError:
        pass
    except Exception as e:
        return False, f"jsonschema validation failed: {e}"

    # Explicit schema rule validation
    required_top = [
        "venture_name", "subtitle", "executive_hook", "formal_breakthrough",
        "verification_receipt", "canonical_pitch_sha256", "character_count", "max_allowed_symbols", "status"
    ]
    for req in required_top:
        if req not in data:
            return False, f"Schema error: missing required top-level property '{req}'"

    if not isinstance(data["venture_name"], str) or len(data["venture_name"]) < 1:
        return False, "Schema error: venture_name must be non-empty string"
    if not isinstance(data["subtitle"], str) or len(data["subtitle"]) < 1:
        return False, "Schema error: subtitle must be non-empty string"

    c_sha = data.get("canonical_pitch_sha256")
    if not isinstance(c_sha, str) or not re.fullmatch(r"[0-9a-fA-F]{64}", c_sha):
        return False, "Schema error: canonical_pitch_sha256 must be a valid 64-character hex SHA-256 digest"

    eh = data["executive_hook"]
    if not isinstance(eh, str) or len(eh) < 50 or len(eh) > 800:
        return False, f"Schema error: executive_hook length ({len(eh) if isinstance(eh, str) else 'N/A'}) out of bounds [50, 800]"

    fb = data["formal_breakthrough"]
    if not isinstance(fb, str) or len(fb) < 50 or len(fb) > 1000:
        return False, f"Schema error: formal_breakthrough length ({len(fb) if isinstance(fb, str) else 'N/A'}) out of bounds [50, 1000]"

    rc = data["character_count"]
    if not isinstance(rc, int) or rc > 1500 or rc < 1:
        return False, f"Schema error: character_count ({rc}) invalid or exceeds 1500"

    if data.get("max_allowed_symbols") != 1500:
        return False, "Schema error: max_allowed_symbols must be const 1500"

    if data.get("status") not in ["VALID", "EXCEEDED_LIMIT", "MALFORMED"]:
        return False, f"Schema error: status '{data.get('status')}' not in enum"

    vr = data["verification_receipt"]
    if not isinstance(vr, dict):
        return False, "Schema error: verification_receipt must be an object"

    required_vr = [
        "proof_engine", "axiom_audit", "repository", "commit_sha", "verification_command"
    ]
    for rvr in required_vr:
        if rvr not in vr or not isinstance(vr[rvr], str) or len(vr[rvr].strip()) == 0:
            return False, f"Schema error: verification_receipt missing or invalid field '{rvr}'"

    return True, "JSON Schema validation passed successfully."


def analyze_pitch(file_path: Path):
    if not file_path.exists():
        return False, f"File not found: {file_path}", {}

    content = file_path.read_text(encoding="utf-8")
    char_count = len(content)

    issues = []
    if char_count > MAX_ALLOWED_SYMBOLS:
        issues.append(f"Character count ({char_count}) exceeds limit of {MAX_ALLOWED_SYMBOLS} symbols by {char_count - MAX_ALLOWED_SYMBOLS}.")

    # Check title (# Title: Subtitle)
    if not re.search(r"^#\s+.+", content, re.MULTILINE):
        issues.append("Missing top-level pitch title (# Venture: Subtitle).")

    # Check sections
    for sec_pattern in MANDATORY_SECTIONS:
        if not re.search(sec_pattern, content, re.MULTILINE):
            issues.append(f"Missing mandatory section header matching pattern: '{sec_pattern}'")

    # Check receipt fields
    receipt_section_match = re.search(r"## 3\.\s+Verification Receipt([\s\S]*)$", content)
    receipt_commit = None
    if not receipt_section_match:
        issues.append("Unable to parse Section 3 (Verification Receipt).")
    else:
        receipt_text = receipt_section_match.group(1)
        for field in MANDATORY_RECEIPT_FIELDS:
            if field not in receipt_text:
                issues.append(f"Verification Receipt is missing required coordinate field: '{field}'")
        c_match = re.search(r"Commit SHA:\*{0,2}\s*`?([^\n`]+)`?", receipt_text)
        if c_match:
            receipt_commit = c_match.group(1).strip()

    sha256_hash = hashlib.sha256(content.encode("utf-8")).hexdigest()

    meta = {
        "file": str(file_path),
        "char_count": char_count,
        "max_symbols": MAX_ALLOWED_SYMBOLS,
        "sha256": sha256_hash,
        "receipt_commit": receipt_commit,
        "valid": len(issues) == 0,
        "issues": issues,
    }
    return len(issues) == 0, issues, meta


def cmd_count(file_path: Path):
    valid, issues, meta = analyze_pitch(file_path)
    print(f"File: {file_path}")
    print(f"Characters (Symbols): {meta.get('char_count', 'N/A')} / {MAX_ALLOWED_SYMBOLS}")
    print(f"SHA-256: {meta.get('sha256', 'N/A')}")
    if valid:
        print("Status: ✅ PASS (Within budget)")
        return 0
    else:
        print("Status: ❌ FAIL")
        for iss in issues:
            print(f" - {iss}")
        return 1


def cmd_verify(file_path: Path):
    valid, issues, meta = analyze_pitch(file_path)
    print(f"=== VHP-01 Verification: {file_path.name} ===")
    print(f"Character Count: {meta['char_count']} / {MAX_ALLOWED_SYMBOLS} symbols")
    print(f"SHA-256: {meta['sha256']}")

    # Static AST Audit
    script_path = Path(__file__).resolve()
    ast_ok, ast_msg, _ = audit_verifier_ast(script_path)
    if ast_ok:
        print(f"AST Audit: ✅ {ast_msg}")
    else:
        print(f"AST Audit: ❌ {ast_msg}")
        issues.append(f"AST audit failure: {ast_msg}")

    # Wheel Property Checks on Representative Domain
    ax_ok, ax_msg, *rest = verify_wheel_axioms()
    if ax_ok:
        print(f"Axiom Properties: ✅ {ax_msg}")
    else:
        print(f"Axiom Properties: ❌ {ax_msg}")
        issues.append(f"Axiom property failure: {ax_msg}")

    # Commit verification if present
    receipt_commit = meta.get("receipt_commit")
    if receipt_commit:
        root_dir = file_path.resolve().parent
        while root_dir.parent != root_dir and not (root_dir / ".git").exists():
            root_dir = root_dir.parent

        receipt_file = root_dir / "pitch" / "artifacts" / "pitch_verification_receipt.json"
        expected_audited = None
        if receipt_file.exists():
            try:
                with open(receipt_file, "r", encoding="utf-8") as rf:
                    rdata = json.load(rf)
                    expected_audited = rdata.get("audited_commit") or rdata.get("commit_sha")
            except Exception:
                pass

        c_ok, c_msg = verify_receipt_commit(receipt_commit, root_dir, expected_commit=expected_audited)
        if c_ok:
            print(f"Commit Coordinate: ✅ {c_msg}")
            try:
                rel_path = file_path.relative_to(root_dir)
                res_show = subprocess.run(
                    ["git", "show", f"{receipt_commit}:{rel_path}"],
                    cwd=str(root_dir),
                    capture_output=True,
                    text=True
                )
                if res_show.returncode == 0:
                    tree_sha = hashlib.sha256(res_show.stdout.encode("utf-8")).hexdigest()
                    print(f"Audited Target Tree Artifact: ✅ git show {receipt_commit[:8]}:{rel_path} verified ({tree_sha[:16]}...)")
            except Exception:
                pass
        else:
            print(f"Commit Coordinate: ❌ {c_msg}")
            issues.append(f"Commit coordinate mismatch: {c_msg}")

    if valid and len(issues) == 0:
        print("Result: ✅ PASSED (Structural schema, symbol budget, AST audit, sample properties & commit verified)")
        return 0
    else:
        print("Result: ❌ FAILED")
        for iss in issues:
            print(f"  • {iss}")
        return 1


def cmd_check_all(root_dir: Path, receipt_path: Path = None, ref_json_path: Path = None, ref_pitch_path: Path = None):
    receipt_file = receipt_path if receipt_path else (root_dir / "pitch" / "artifacts" / "pitch_verification_receipt.json")
    schema_file = root_dir / "pitch" / "artifacts" / "pitch_schema.json"
    ref_json = ref_json_path if ref_json_path else (root_dir / "pitch" / "artifacts" / "reference_pitch.json")
    ref_pitch = ref_pitch_path if ref_pitch_path else (root_dir / "pitch" / "vhp-01-reference-pitch.md")
    tmpl_pitch = root_dir / "pitch" / "vhp-01-pitch-template.md"

    receipt_data = {}
    if receipt_file.exists():
        try:
            with open(receipt_file, "r", encoding="utf-8") as rf:
                receipt_data = json.load(rf)
        except Exception:
            pass

    audited_target = receipt_data.get("audited_commit") or receipt_data.get("commit_sha") or "UNKNOWN"
    head_sha = get_git_head_sha(root_dir) or "UNKNOWN"

    print("=" * 60)
    print("VHP-01 Formal Verification Suite & Receipt Auditor")
    print(f"Target Proof Commit (audited):  {audited_target}")
    print(f"Signing Receipt Commit:         {head_sha} (HEAD)")
    print("=" * 60)

    all_ok = True

    # Audited Commit Tree Verification (git show <sha>:<path>)
    print(f"\nAuditing Audited Commit Tree (git show {audited_target[:8]}):")
    if audited_target and audited_target != "UNKNOWN":
        tree_ok, tree_summary, tree_details = verify_audited_commit_tree(audited_target, receipt_data, root_dir)
        if tree_ok:
            for item in tree_details:
                print(f"  ✅ {item}")
            print(f"  ✅ Tree Audit: {tree_summary}")
        else:
            print(f"  ❌ Tree Audit Failure: {tree_summary}")
            for iss in tree_details:
                print(f"     - {iss}")
            all_ok = False
    else:
        print("  ❌ No audited_commit specified in receipt")
        all_ok = False

    targets = [ref_pitch, tmpl_pitch]

    for target in targets:
        print(f"\nAuditing: {target.relative_to(root_dir) if target.is_relative_to(root_dir) else target.name}")
        ok, issues, meta = analyze_pitch(target)
        if ok:
            print(f"  ✅ {meta['char_count']} symbols (<= {MAX_ALLOWED_SYMBOLS}) | SHA-256: {meta['sha256'][:16]}...")
        else:
            all_ok = False
            print(f"  ❌ Failed with {len(issues)} issues:")
            for iss in issues:
                print(f"     - {iss}")

    # Validate JSON artifacts
    print(f"\nAuditing JSON Artifacts:")
    loaded_data = {}
    for jf in [schema_file, receipt_file, ref_json]:
        display_path = jf.name
        try:
            display_path = str(jf.relative_to(root_dir))
        except ValueError:
            pass
        if not jf.exists():
            print(f"  ❌ Missing: {display_path}")
            all_ok = False
        else:
            try:
                with open(jf, "r", encoding="utf-8") as f:
                    key = "pitch_verification_receipt.json" if jf == receipt_file else ("reference_pitch.json" if jf == ref_json else jf.name)
                    loaded_data[key] = json.load(f)
                print(f"  ✅ Parsed valid JSON: {display_path}")
            except Exception as e:
                print(f"  ❌ Invalid JSON {display_path}: {e}")
                all_ok = False

    # Schema Validation of reference_pitch.json against pitch_schema.json
    if "reference_pitch.json" in loaded_data and "pitch_schema.json" in loaded_data:
        s_ok, s_msg = validate_pitch_schema(loaded_data["reference_pitch.json"], loaded_data["pitch_schema.json"])
        if s_ok:
            print(f"  ✅ Schema Validation: {s_msg}")
        else:
            print(f"  ❌ Schema Validation Failure: {s_msg}")
            all_ok = False

    # Verify Receipt Commit matches audited target commit across all representations
    if "reference_pitch.json" in loaded_data:
        ref_commit = loaded_data["reference_pitch.json"].get("verification_receipt", {}).get("commit_sha")
        c_ok, c_msg = verify_receipt_commit(ref_commit, root_dir, expected_commit=audited_target)
        if c_ok:
            print(f"  ✅ Receipt Commit in reference_pitch.json: {c_msg}")
        else:
            print(f"  ❌ Receipt Commit Mismatch in reference_pitch.json: {c_msg}")
            all_ok = False

    # Cross-check reference pitch markdown commit coordinate
    _, _, ref_meta = analyze_pitch(ref_pitch)
    md_commit = ref_meta.get("receipt_commit")
    if md_commit:
        c_ok, c_msg = verify_receipt_commit(md_commit, root_dir, expected_commit=audited_target)
        if c_ok:
            print(f"  ✅ Reference Pitch Markdown Commit: {c_msg}")
        else:
            print(f"  ❌ Reference Pitch Markdown Commit Mismatch: {c_msg}")
            all_ok = False
    else:
        print("  ❌ Missing Commit SHA in Reference Pitch Markdown")
        all_ok = False

    # Cross-check Verification Command synchronization across all representations
    ref_cmd = loaded_data.get("reference_pitch.json", {}).get("verification_receipt", {}).get("verification_command")
    receipt_cmd = loaded_data.get("pitch_verification_receipt.json", {}).get("verification_command")

    md_text = ref_pitch.read_text(encoding="utf-8") if ref_pitch.exists() else ""
    md_cmd_match = re.search(r"Verification Command:\*{0,2}\s*`?([^\n`]+)`?", md_text)
    md_cmd = md_cmd_match.group(1).strip() if md_cmd_match else None

    if ref_cmd and receipt_cmd and ref_cmd != receipt_cmd:
        print(f"  ❌ Verification command mismatch: reference_pitch.json ('{ref_cmd}') != receipt ('{receipt_cmd}')")
        all_ok = False
    if md_cmd and receipt_cmd and md_cmd != receipt_cmd:
        print(f"  ❌ Verification command mismatch: Markdown ('{md_cmd}') != receipt ('{receipt_cmd}')")
        all_ok = False
    if ref_cmd and md_cmd and ref_cmd == receipt_cmd and md_cmd == receipt_cmd:
        print(f"  ✅ Verification Command synchronized across all representations: {receipt_cmd}")

    # Cross-check Canonical Published Pitch Digest against Receipt
    print(f"\nAuditing Canonical Published Pitch Digest:")
    if receipt_file.exists():
        receipt = loaded_data.get("pitch_verification_receipt.json", {})
        ref_content = ref_pitch.read_text(encoding="utf-8") if ref_pitch.exists() else ""
        actual_canonical_sha = hashlib.sha256(ref_content.encode("utf-8")).hexdigest()
        actual_symbols = len(ref_content)

        checked_any = False
        if "canonical_artifacts" in receipt and "reference_pitch" in receipt["canonical_artifacts"]:
            c_spec = receipt["canonical_artifacts"]["reference_pitch"]
            c_sha = c_spec.get("sha256")
            c_sym = c_spec.get("symbol_count")
            if c_sha != actual_canonical_sha:
                print(f"  ❌ Canonical Pitch SHA-256 mismatch! Expected {c_sha}, got {actual_canonical_sha}")
                all_ok = False
            else:
                print(f"  ✅ Canonical Pitch SHA-256 verified: {actual_canonical_sha[:16]}...")
            if c_sym and c_sym != actual_symbols:
                print(f"  ❌ Canonical Pitch symbol count mismatch! Expected {c_sym}, got {actual_symbols}")
                all_ok = False
            else:
                print(f"  ✅ Canonical Pitch symbol count verified: {actual_symbols} symbols")
            checked_any = True

        if "target_artifacts" in receipt and "reference_pitch" in receipt["target_artifacts"]:
            t_spec = receipt["target_artifacts"]["reference_pitch"]
            t_sha = t_spec.get("sha256")
            t_sym = t_spec.get("symbol_count")
            if t_sha != actual_canonical_sha:
                print(f"  ❌ Target artifacts reference_pitch SHA-256 mismatch! Expected {t_sha}, got {actual_canonical_sha}")
                all_ok = False
            else:
                print(f"  ✅ Target artifacts reference_pitch SHA-256 verified: {actual_canonical_sha[:16]}...")
            checked_any = True

        if not checked_any:
            print("  ❌ No canonical_artifacts or target_artifacts found in receipt")
            all_ok = False

    # Cross-check Structured Binding (reference_pitch.json <-> Canonical Pitch)
    print(f"\nAuditing Structured Binding (reference_pitch.json <-> Canonical Pitch):")
    if "reference_pitch.json" in loaded_data and ref_pitch.exists():
        ref_json_data = loaded_data["reference_pitch.json"]
        ref_text = ref_pitch.read_text(encoding="utf-8")
        actual_md_sha = hashlib.sha256(ref_text.encode("utf-8")).hexdigest()

        # 1. Digest binding
        ref_json_sha = ref_json_data.get("canonical_pitch_sha256")
        if not ref_json_sha:
            print("  ❌ reference_pitch.json missing 'canonical_pitch_sha256' field")
            all_ok = False
        elif ref_json_sha != actual_md_sha:
            print(f"  ❌ reference_pitch.json canonical_pitch_sha256 mismatch: expected {actual_md_sha}, got {ref_json_sha}")
            all_ok = False
        else:
            print(f"  ✅ reference_pitch.json canonical_pitch_sha256 matches Canonical Markdown: {ref_json_sha[:16]}...")

        # 2. Executive Hook text binding
        hook_match = re.search(r"## 1\.\s+Executive Hook\s*\n([\s\S]*?)(?=\n##|$)", ref_text)
        md_hook = hook_match.group(1).strip() if hook_match else ""
        json_hook = ref_json_data.get("executive_hook", "").strip()
        if not md_hook or md_hook != json_hook:
            print(f"  ❌ Executive Hook content mismatch between reference_pitch.json and Markdown")
            all_ok = False
        else:
            print("  ✅ Executive Hook structured content matches Canonical Markdown")

        # 3. Formal Breakthrough text binding
        breakthrough_match = re.search(r"## 2\.\s+Formal Breakthrough\s*\n([\s\S]*?)(?=\n##|$)", ref_text)
        md_breakthrough = breakthrough_match.group(1).strip() if breakthrough_match else ""
        json_breakthrough = ref_json_data.get("formal_breakthrough", "").strip()
        norm_md = normalize_pitch_text(md_breakthrough)
        norm_json = normalize_pitch_text(json_breakthrough)
        if not md_breakthrough or norm_md != norm_json:
            print(f"  ❌ Formal Breakthrough content mismatch between reference_pitch.json and Markdown")
            all_ok = False
        else:
            print("  ✅ Formal Breakthrough structured content matches Canonical Markdown")

        # 4. Title / Venture name binding
        title_match = re.search(r"^#\s*([^:\n]+):\s*([^\n]+)", ref_text, re.MULTILINE)
        if title_match:
            md_venture = title_match.group(1).strip()
            md_subtitle = title_match.group(2).strip()
            if ref_json_data.get("venture_name") != md_venture:
                print(f"  ❌ Venture name mismatch: json '{ref_json_data.get('venture_name')}' != md '{md_venture}'")
                all_ok = False
            if ref_json_data.get("subtitle") != md_subtitle:
                print(f"  ❌ Subtitle mismatch: json '{ref_json_data.get('subtitle')}' != md '{md_subtitle}'")
                all_ok = False
            if ref_json_data.get("venture_name") == md_venture and ref_json_data.get("subtitle") == md_subtitle:
                print(f"  ✅ Title and subtitle match Canonical Markdown: {md_venture}: {md_subtitle}")

        # 5. Character count binding
        if ref_json_data.get("character_count") != len(ref_text):
            print(f"  ❌ Character count mismatch: reference_pitch.json ({ref_json_data.get('character_count')}) != Markdown ({len(ref_text)})")
            all_ok = False
        else:
            print(f"  ✅ Character count matches Canonical Markdown: {len(ref_text)} symbols")

    # Cross-check receipt SHA with audited target commit tree artifact
    if receipt_file.exists():
        receipt = loaded_data.get("pitch_verification_receipt.json", {})
        tree_expected_sha = receipt.get("audited_tree_artifacts", {}).get("reference_pitch", {}).get("sha256")
        if tree_expected_sha:
            res_tree = subprocess.run(
                ["git", "show", f"{audited_target}:pitch/vhp-01-reference-pitch.md"],
                cwd=str(root_dir),
                capture_output=True,
                text=True
            )
            if res_tree.returncode == 0:
                tree_actual_sha = hashlib.sha256(res_tree.stdout.encode("utf-8")).hexdigest()
                if tree_expected_sha == tree_actual_sha:
                    print(f"  ✅ Audited target commit ({audited_target[:8]}) tree artifact matches historical receipt ({tree_actual_sha[:16]}...)")
                else:
                    print(f"  ❌ Audited target tree artifact SHA-256 mismatch! Expected {tree_expected_sha}, got {tree_actual_sha}")
                    all_ok = False

    # Static AST Audit
    print(f"\nStatic AST Audit (verify-vhp-pitch):")
    script_path = root_dir / "tools" / "verify-vhp-pitch"
    ast_ok, ast_msg, _ = audit_verifier_ast(script_path)
    if ast_ok:
        print(f"  ✅ {ast_msg}")
    else:
        print(f"  ❌ {ast_msg}")
        all_ok = False

    # Representative Domain Property Checks
    print(f"\nRepresentative Domain Property Checks (Carlström Wheel Theory W(Q)):")
    ax_ok, ax_msg, *rest = verify_wheel_axioms()
    if ax_ok:
        print(f"  ✅ {ax_msg}")
    else:
        print(f"  ❌ {ax_msg}")
        all_ok = False

    if all_ok:
        print("\n🎉 ALL VHP-01 CHECKS PASSED.")
        return 0
    else:
        print("\n❌ SOME CHECKS FAILED.")
        return 1


def main():
    root_dir = Path(__file__).resolve().parent.parent
    if len(sys.argv) < 2:
        return cmd_check_all(root_dir)

    subcommand = sys.argv[1]
    if subcommand == "check-all":
        import argparse
        parser = argparse.ArgumentParser(prog="verify-vhp-pitch check-all", add_help=False)
        parser.add_argument("receipt_pos", nargs="?", default=None)
        parser.add_argument("--receipt", default=None)
        parser.add_argument("--ref-json", default=None)
        parser.add_argument("--ref-pitch", default=None)
        args, _ = parser.parse_known_args(sys.argv[2:])
        receipt_arg = Path(args.receipt) if args.receipt else (Path(args.receipt_pos) if args.receipt_pos else None)
        ref_json_arg = Path(args.ref_json) if args.ref_json else None
        ref_pitch_arg = Path(args.ref_pitch) if args.ref_pitch else None
        return cmd_check_all(root_dir, receipt_path=receipt_arg, ref_json_path=ref_json_arg, ref_pitch_path=ref_pitch_arg)
    elif subcommand == "check-axioms":
        ok, msg, *rest = verify_wheel_axioms()
        print(f"Axiom Properties: {'PASS' if ok else 'FAIL'} - {msg}")
        return 0 if ok else 1
    elif subcommand == "check-ast":
        script_path = Path(__file__).resolve()
        ok, msg, _ = audit_verifier_ast(script_path)
        print(f"AST Audit: {'PASS' if ok else 'FAIL'} - {msg}")
        return 0 if ok else 1
    elif subcommand == "count":
        target = Path(sys.argv[2]) if len(sys.argv) > 2 else root_dir / "pitch" / "vhp-01-reference-pitch.md"
        return cmd_count(target)
    elif subcommand == "verify":
        target = Path(sys.argv[2]) if len(sys.argv) > 2 else root_dir / "pitch" / "vhp-01-reference-pitch.md"
        return cmd_verify(target)
    else:
        target = Path(subcommand)
        if target.exists():
            return cmd_verify(target)
        print(f"Unknown subcommand or file: {subcommand}")
        return 1


if __name__ == "__main__":
    sys.exit(main())
