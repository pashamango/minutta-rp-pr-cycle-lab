#!/usr/bin/env python3
"""Local interactive upgrade only. Atomic LaunchAgent pointer; fail-closed recovery journal."""
import argparse
import base64
import hashlib
import importlib.machinery
import importlib.util
import json
import os
from pathlib import Path
import platform
import plistlib
import re
import subprocess
import sys

ROOT = Path(__file__).resolve().parents[1]
BRANCH = 'agent/wolfram/DARWIN-MAILBOX-0002-BOOTSTRAP-01'
REPO = 'pashamango/minutta-rp-pr-cycle-lab'
BASE = Path.home() / 'ChitAkasha-Darwin/agent-mailbox'
LABEL = 'com.chitakasha.darwin-agent-mailbox'
PLIST = Path.home() / 'Library/LaunchAgents' / (LABEL + '.plist')


def load(name):
    loader = importlib.machinery.SourceFileLoader(name.replace('-', '_'), str(ROOT / 'tools' / name))
    spec = importlib.util.spec_from_loader(loader.name, loader)
    value = importlib.util.module_from_spec(spec)
    loader.exec_module(value)
    return value


m = load('darwin-agent-mailbox')
manager = load('darwin-mailbox-manage')
FILES = (*manager.FILES, 'tools/darwin-mailbox-capabilities', 'tools/darwin-mailbox-static-server',
         'tools/darwin-mailbox-upgrade', 'docs/darwin-mailbox-capabilities.md')


def sha(data):
    return hashlib.sha256(data).hexdigest()


def local_host():
    if platform.system() != 'Darwin' or os.getuid() == 0:
        raise ValueError('run locally as the existing non-root Darwin user')
    name = subprocess.run(['/usr/sbin/scutil', '--get', 'ComputerName'], capture_output=True,
                          text=True, timeout=10, check=True).stdout.strip().lower()
    if name != 'darwin':
        raise ValueError('ComputerName must be Darwin; no cross-host upgrade')


def checked(pr, head, api):
    if type(pr) is not int or pr < 1 or not re.fullmatch('[a-f0-9]{40}', head or ''):
        raise ValueError('actual PR and tested 40-character head required')
    value = api(['api', f'repos/{REPO}/pulls/{pr}'])
    if (value.get('number') != pr or value.get('merged') is not True or value.get('state') != 'closed'
            or value.get('head', {}).get('sha') != head or value.get('head', {}).get('ref') != BRANCH
            or value.get('base', {}).get('ref') != 'main'
            or any(value.get(k, {}).get('repo', {}).get('full_name') != REPO for k in ('base', 'head'))):
        raise ValueError('PR/repository/branch/base/head/merged state mismatch')
    merged = value.get('merge_commit_sha', '')
    if not re.fullmatch('[a-f0-9]{40}', merged):
        raise ValueError('invalid merge commit')
    for commit in (head, merged):
        comparison = api(['api', f'repos/{REPO}/compare/{commit}...main'])
        if comparison.get('status') not in ('ahead', 'identical'):
            raise ValueError('tested head and merge must both be ancestors of canonical main; use merge commit')
    return merged


def verified(pr, head):
    if m.gh(['api', 'user']).get('login') != 'pashamango':
        raise ValueError('existing pashamango gh authorization required')
    merged = checked(pr, head, m.gh)
    # Manager compares git object, checkout bytes and merged GitHub file for every payload.
    original = manager.FILES
    manager.FILES = FILES
    try:
        files = manager.verified_files(merged, head, m.gh)
    finally:
        manager.FILES = original
    return merged, files


def atomic(path, data):
    if path.is_symlink():
        raise ValueError('symlink target')
    temporary = path.with_name('.' + path.name + '.upgrade-tmp')
    fd = os.open(temporary, os.O_CREAT | os.O_EXCL | os.O_WRONLY | os.O_NOFOLLOW, 0o600)
    try:
        with os.fdopen(fd, 'wb') as stream:
            stream.write(data)
            stream.flush()
            os.fsync(stream.fileno())
        os.replace(temporary, path)
        fd = os.open(path.parent, os.O_RDONLY)
        try:
            os.fsync(fd)
        finally:
            os.close(fd)
    finally:
        temporary.unlink(missing_ok=True)


def history(base):
    values = {}
    state = base / 'state'
    for directory in ('inbox', 'seen', 'claims', 'runs', 'revisions'):
        root = state / directory
        if root.is_symlink():
            raise ValueError('symlink history')
        for p in sorted(root.rglob('*')):
            if p.is_symlink() or not (p.is_file() or p.is_dir()):
                raise ValueError('unsafe history')
            if p.is_file():
                values[str(p.relative_to(state))] = sha(p.read_bytes())
    values['control/activation.json'] = sha((state / 'control/activation.json').read_bytes())
    return values


def owned(base, plist):
    installation = m.strict_json(base / 'state/control/installation.json')
    # Initial manifest is deliberately never rewritten. A successful upgrade has a separate journal.
    journal_path = base / 'state/control/upgrade.json'
    if journal_path.exists():
        journal = m.strict_json(journal_path)
        if journal.get('status') != 'rolled-back':
            raise ValueError('upgrade already recorded; inspect or rollback, never silently overwrite')
    release = base / 'releases' / installation['merged_commit']
    if not re.fullmatch('[a-f0-9]{40}', installation['merged_commit']):
        raise ValueError('invalid installed release')
    if set(installation['files']) != set(manager.FILES):
        raise ValueError('unrecognized original installation manifest')
    for name, digest in installation['files'].items():
        p = release / name
        load("darwin-mailbox-capabilities").safe_path(p)
        if p.is_symlink() or sha(p.read_bytes()) != digest:
            raise ValueError('installed bytes differ from original manifest')
    load('darwin-mailbox-capabilities').safe_path(base / 'config/policy.yaml')
    if (base / 'config/policy.yaml').read_bytes() != (release / 'config/darwin-agent-mailbox-policy.yaml').read_bytes():
        raise ValueError('installed policy bytes drifted')
    m.check_policy(base / 'config/policy.yaml')
    load("darwin-mailbox-capabilities").safe_path(plist)
    if plist.is_symlink():
        raise ValueError('symlink LaunchAgent')
    data = plist.read_bytes()
    value = plistlib.loads(data)
    args = value.get('ProgramArguments')
    if (value.get('Label') != LABEL or value.get('WorkingDirectory') != str(base)
            or not isinstance(args, list) or len(args) != 2
            or args[1] != str(release / 'tools/darwin-agent-mailbox')
            or value.get('StartInterval') != 60 or value.get('RunAtLoad') is not True
            or value.get('StandardOutPath') != '/dev/null' or value.get('StandardErrorPath') != '/dev/null'
            or set(value) != {'Label', 'ProgramArguments', 'WorkingDirectory', 'StartInterval', 'RunAtLoad',
                              'EnvironmentVariables', 'Umask', 'StandardOutPath', 'StandardErrorPath'}
            or value.get('Umask') != 63 or set(value.get('EnvironmentVariables', {})) != {'PATH'}):
        raise ValueError('LaunchAgent is not owned by the original Darwin installation')
    activation = m.strict_json(base / 'state/control/activation.json')
    if activation.get('mode') != 'normal' or not activation.get('smoke_verified_at'):
        raise ValueError('existing activation must have completed its original smoke')
    return data, value


def smoke(base):
    """No queue fetch, no Codex, no Issue creation, no cycle or dispatch invocation."""
    before = history(base)
    watcher, dispatcher, _ = m.components()
    body = manager.smoke_body('UPGRADE-OFFLINE-PROBE')
    item = {'number': 999999, 'state': 'OPEN', 'author': {'login': 'pashamango'},
            'body': body, 'lastEditedAt': None}
    metadata, error = watcher.validate(REPO, item)
    if error or load('darwin-mailbox-capabilities').declaration(metadata)['capabilities']:
        raise ValueError('legacy parsing changed')
    if dispatcher.codex_command('codex', Path('/probe')) != load('wolfram-agent-dispatcher').codex_command('codex', Path('/probe')):
        raise ValueError('legacy permission command changed')
    if 'Default: no listeners or infrastructure changes.' not in dispatcher.PREAMBLE:
        raise ValueError('restrictive default missing')
    scope = {'application': 'upgrade-probe', 'port': 18765, 'operation': 'install', 'serve_path': '/upgrade-probe/'}
    cap = load('darwin-mailbox-capabilities')
    for names in (['loopback-user-service'], ['tailscale-serve-additive'], sorted(cap.ALLOWLIST)):
        selected = dict(scope, serve_path=scope['serve_path'] if 'tailscale-serve-additive' in names else None)
        value = dict(metadata, risk='R1', capabilities=json.dumps(names), capability_scope=json.dumps(selected))
        declared_body = body.replace('risk: R0', 'risk: R1\ncapabilities: ' + value['capabilities']
                                     + '\ncapability_scope: ' + value['capability_scope'])
        declared_issue = dict(item, body=declared_body)
        parsed, error = watcher.validate(REPO, declared_issue)
        if error or cap.declaration(parsed) != cap.declaration(value):
            raise ValueError('capability source parsing failed')
        if watcher.normalized_payload(REPO, item) == watcher.normalized_payload(REPO, declared_issue):
            raise ValueError('capability source not digest bound')
        envelope = dict(cap.declaration(parsed), risk='R1')
        cap.bound(envelope, parsed)
        changed = dict(envelope, capabilities=[])
        try:
            cap.bound(changed, value)
        except ValueError:
            pass
        else:
            raise ValueError('capability binding not enforced')
    activation = m.strict_json(base / 'state/control/activation.json')
    for number in (55, 56, 57, 58):
        if m.eligible(dict(item, number=number, createdAt='2099-01-01T00:00:00Z'), activation, watcher):
            raise ValueError('historical exclusion failed')
    if history(base) != before:
        raise ValueError('offline smoke changed history')
    return {'legacy-restrictive': 'pass', 'capability-parsing-binding': 'pass',
            'historical-execution-count': 0, 'historical-state-unchanged': 'pass'}


def launch(*args):
    subprocess.run(['launchctl', *args], capture_output=True, check=True, timeout=20)


def upgrade(pr, head, base=BASE, plist=PLIST):
    local_host()
    os.umask(0o077)
    # No installation mutation until remote merge/head checks and all payload bytes pass.
    merged, files = verified(pr, head)
    if not base.is_dir():
        raise ValueError('existing Darwin installation required; use no initial activation here')
    m.real_directory(base)
    control = base / 'state/control'
    with m.locked(control / 'install.lock') as install_lock, m.locked(control / 'cycle.lock') as cycle_lock:
        if not install_lock or not cycle_lock:
            raise ValueError('mailbox is busy; retry locally after current task ends')
        if (control / 'disabled.json').exists():
            raise ValueError('disabled installation requires local recovery review first')
        old_data, value = owned(base, plist)
        before = history(base)
        smoke_result = smoke(base)
        release = base / 'releases' / merged
        for name, data in files.items():
            manager.put(release / name, data)
        for name, data in files.items():
            if sha((release / name).read_bytes()) != sha(data):
                raise ValueError('staged installed bytes mismatch')
        value['ProgramArguments'][1] = str(release / 'tools/darwin-agent-mailbox')
        new_data = plistlib.dumps(value, sort_keys=True)
        loaded = manager.launch_status()
        journal = {'status': 'prepared', 'pr': pr, 'head': head, 'merged': merged,
                   'old_plist': base64.b64encode(old_data).decode(), 'new_plist_sha256': sha(new_data),
                   'was_loaded': loaded, 'history': before, 'smoke': smoke_result,
                   'files': {k: sha(v) for k, v in files.items()}}
        journal_path = control / 'upgrade.json'
        if journal_path.exists():
            raise ValueError('previous upgrade journal requires a new reviewed upgrade')
        manager.put(journal_path, json.dumps(journal, sort_keys=True).encode())
        manager.put(control / 'disabled.json', b'{"disabled":true}\n')
        domain = 'gui/' + str(os.getuid())
        try:
            if loaded:
                launch('bootout', domain + '/' + LABEL)
            atomic(plist, new_data)  # Only runtime selection changes, in one atomic replacement.
            if sha(plist.read_bytes()) != journal['new_plist_sha256'] or history(base) != before:
                raise ValueError('pointer/history verification failed')
            # Verify using staged installed modules, still without dispatching anything.
            result = subprocess.run([sys.executable, str(release / 'tools/darwin-mailbox-upgrade'), 'smoke'],
                                    capture_output=True, text=True, check=True, timeout=30)
            journal['installed_smoke'] = json.loads(result.stdout)
            if history(base) != before:
                raise ValueError('installed smoke modified history')
            if loaded:
                launch('bootstrap', domain, str(plist))
            journal['status'] = 'committed'
            atomic(journal_path, json.dumps(journal, sort_keys=True).encode())
            (control / 'disabled.json').unlink()
        except BaseException:
            # Keep gate installed if recovery itself fails. Never resume a mixed/uncertain runtime.
            if manager.launch_status():
                launch('bootout', domain + '/' + LABEL)
            atomic(plist, old_data)
            if history(base) != before:
                raise ValueError('history changed; left disabled for manual review')
            if loaded:
                launch('bootstrap', domain, str(plist))
            journal['status'] = 'rolled-back'
            atomic(journal_path, json.dumps(journal, sort_keys=True).encode())
            (control / 'disabled.json').unlink()
            raise
        return {'status': 'upgraded', 'pr': pr, 'head': head, 'installed_files_verified': len(files),
                'history_preserved': True, 'smoke': journal['installed_smoke']}


def rollback(base=BASE, plist=PLIST):
    local_host()
    control = base / 'state/control'
    with m.locked(control / 'install.lock') as a, m.locked(control / 'cycle.lock') as b:
        if not a or not b:
            raise ValueError('mailbox busy; wait for the active task')
        journal = m.strict_json(control / 'upgrade.json')
        data = base64.b64decode(journal['old_plist'], validate=True)
        if sha(plist.read_bytes()) not in (journal['new_plist_sha256'], sha(data)):
            raise ValueError('unknown runtime pointer; manual review required')
        # Verify original manifest and bytes without trusting the upgraded pointer.
        original = m.strict_json(control / 'installation.json')
        if (not re.fullmatch('[a-f0-9]{40}', original['merged_commit'])
                or set(original['files']) != set(manager.FILES)):
            raise ValueError('unrecognized rollback manifest')
        release = base / 'releases' / original['merged_commit']
        for name, expected in original['files'].items():
            load('darwin-mailbox-capabilities').safe_path(release / name)
            if name not in manager.FILES or (release / name).is_symlink() or sha((release / name).read_bytes()) != expected:
                raise ValueError('rollback installed bytes mismatch')
        old = plistlib.loads(data)
        if old.get('ProgramArguments', [None, None])[1] != str(release / 'tools/darwin-agent-mailbox'):
            raise ValueError('rollback pointer mismatch')
        before = history(base)  # Preserve even new history accumulated since upgrade.
        manager.put(control / 'disabled.json', b'{"disabled":true}\n')
        domain = 'gui/' + str(os.getuid())
        if manager.launch_status():
            launch('bootout', domain + '/' + LABEL)
        atomic(plist, data)
        if history(base) != before:
            raise ValueError('history changed; remain disabled')
        if journal['was_loaded']:
            launch('bootstrap', domain, str(plist))
        journal['status'] = 'rolled-back'
        atomic(control / 'upgrade.json', json.dumps(journal, sort_keys=True).encode())
        (control / 'disabled.json').unlink()
        return {'status': 'rolled-back', 'history_preserved': True}


def main():
    parser = argparse.ArgumentParser()
    parser.add_argument('command', choices=('upgrade', 'rollback', 'smoke'))
    parser.add_argument('--pr', type=int)
    parser.add_argument('--expected-head')
    args = parser.parse_args()
    try:
        value = upgrade(args.pr, args.expected_head) if args.command == 'upgrade' else rollback() if args.command == 'rollback' else smoke(BASE)
        print(json.dumps(value, sort_keys=True))
        return 0
    except Exception as exc:
        print('darwin-mailbox-upgrade: ' + str(exc), file=sys.stderr)
        return 1

if __name__ == '__main__':
    raise SystemExit(main())
