#!/usr/bin/env python3
"""Bounded GitHub status reporter for verified Wolfram mailbox runs."""

import argparse
import hashlib
import importlib.machinery
import importlib.util
import json
import os
from pathlib import Path
import re
import shutil
import subprocess
import sys
import uuid

EXPECTED_REPOSITORY = "pashamango/minutta-rp-pr-cycle-lab"
EXPECTED_AGENT = "codex@wolfram.local"
EXPECTED_BRANCH_PREFIX = "agent/wolfram/"
ALLOWED_RISKS = {"R0", "R1"}
EXECUTION_STATES = {"execution_finished": "EXECUTION_FINISHED",
                    "execution_failed": "EXECUTION_FAILED", "timed_out": "TIMED_OUT"}
TASK_STATES = {"completed": "TASK_COMPLETED", "blocked": "TASK_BLOCKED",
               "failed": "TASK_FAILED"}
COMMON_FIELDS = ("task_id", "agent", "source_sha256", "lease_id")
EXECUTION_FIELDS = ("started_at", "finished_at", "exit_status", "stdout_sha256",
                    "stderr_sha256", "result_sha256")
TASK_FIELDS = ("outcome_status", "artifact_count", "check_count",
               "outcome_sha256", "evidence_validation")
OUTCOME_KEYS = {"protocol", "task_id", "lease_id", "source_sha256", "status",
                "summary", "artifacts", "checks"}
VALIDATION_PROTOCOL = "chitakasha-reporter-validation/v1"
REPORTER_AUTHORITY = "wolfram-agent-reporter"
REPORTER_PROTOCOL = VALIDATION_PROTOCOL
MARKER_KEYS = {"receipt_key", "state", "remote"}
MARKER_REMOTE = {"posted": "posted", "existing": "confirmed-existing"}


def load_watcher(path=None):
    path = path or Path(__file__).with_name("wolfram-agent-watcher")
    loader = importlib.machinery.SourceFileLoader("wolfram_agent_watcher_reporter", str(path))
    spec = importlib.util.spec_from_loader(loader.name, loader)
    module = importlib.util.module_from_spec(spec)
    loader.exec_module(module)
    return module


def file_sha256(path):
    return hashlib.sha256(path.read_bytes()).hexdigest()


def write_exclusive(path, value):
    path.parent.mkdir(parents=True, exist_ok=True)
    temporary = path.parent / f".{path.name}.{os.getpid()}.{uuid.uuid4().hex}.tmp"
    try:
        fd = os.open(temporary, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
        with os.fdopen(fd, "w", encoding="utf-8") as stream:
            json.dump(value, stream, indent=2, sort_keys=True)
            stream.write("\n")
            stream.flush()
            os.fsync(stream.fileno())
        os.chmod(temporary, 0o444)
        os.link(temporary, path)
    finally:
        temporary.unlink(missing_ok=True)


class GhClient:
    def __init__(self, executable=None):
        self.executable = executable or shutil.which("gh")
        if not self.executable:
            raise RuntimeError("GitHub CLI is unavailable")

    def _run(self, args, input_text=None):
        result = subprocess.run([self.executable, *args], input=input_text, capture_output=True,
                                text=True, timeout=45)
        if result.returncode:
            raise RuntimeError("GitHub CLI request failed")
        return json.loads(result.stdout) if result.stdout.strip() else None

    def issue(self, repository, number):
        raw = self._run(["api", f"repos/{repository}/issues/{number}"])
        return {"number": raw["number"], "title": raw["title"],
                "author": {"login": raw["user"]["login"]}, "url": raw["html_url"],
                "createdAt": raw["created_at"], "updatedAt": raw["updated_at"],
                "state": raw["state"].upper(), "body": raw.get("body") or ""}

    def comments(self, repository, number):
        return self._run(["api", "--paginate", f"repos/{repository}/issues/{number}/comments"])

    def post(self, repository, number, body):
        return self._run(["api", "--method", "POST", f"repos/{repository}/issues/{number}/comments",
                          "--input", "-"], json.dumps({"body": body}))

    def pull_request(self, repository, number):
        return self._run(["api", f"repos/{repository}/pulls/{number}"])


def validate_scalar(name, value, pattern=r"[A-Za-z0-9][A-Za-z0-9._:@+-]{0,127}"):
    if not isinstance(value, str) or not re.fullmatch(pattern, value):
        raise ValueError(f"invalid {name}")
    return value


def load_bound_run(run_dir, state):
    envelope = json.loads((run_dir / "envelope.json").read_text(encoding="utf-8"))
    claim = json.loads((run_dir / "claim.json").read_text(encoding="utf-8"))
    repository = envelope.get("source_repository")
    issue_number = envelope.get("source_issue")
    task_id = validate_scalar("task_id", envelope.get("task_id"))
    lease_id = validate_scalar("lease_id", envelope.get("lease_id"), r"[a-f0-9]{32}")
    digest = validate_scalar("source_sha256", envelope.get("source_sha256"), r"[a-f0-9]{64}")
    if repository != EXPECTED_REPOSITORY or envelope.get("agent") != EXPECTED_AGENT:
        raise ValueError("run outside reporter trust boundary")
    if envelope.get("risk") not in ALLOWED_RISKS or not isinstance(issue_number, int):
        raise ValueError("unauthorized risk or issue")
    bindings = {"task_id": task_id, "lease_id": lease_id, "source_digest": digest,
                "agent": EXPECTED_AGENT, "issue_number": issue_number}
    if any(claim.get(key) != value for key, value in bindings.items()):
        raise ValueError("claim does not match run envelope")
    result = None
    if state != "CLAIMED":
        result_path = run_dir / "result.json"
        result = json.loads(result_path.read_text(encoding="utf-8"))
        expected_state = EXECUTION_STATES.get(result.get("terminal_state"))
        if ((state == "TASK_OUTCOME" and expected_state != "EXECUTION_FINISHED")
                or (state != "TASK_OUTCOME" and expected_state != state)
                or result.get("task_id") != task_id or result.get("lease_id") != lease_id):
            raise ValueError("result does not match requested run state")
        if result.get("source_digest") != digest:
            raise ValueError("result digest does not match run envelope")
    return envelope, claim, result


def load_outcome(run_dir, envelope):
    path = run_dir / "task-outcome.json"
    outcome = json.loads(path.read_text(encoding="utf-8"))
    if not isinstance(outcome, dict) or set(outcome) != OUTCOME_KEYS:
        raise ValueError("invalid task outcome schema")
    expected = {"protocol": "chitakasha-task-outcome/v1", "task_id": envelope["task_id"],
                "lease_id": envelope["lease_id"], "source_sha256": envelope["source_sha256"]}
    if any(outcome.get(key) != value for key, value in expected.items()):
        raise ValueError("task outcome binding mismatch")
    if outcome.get("status") not in TASK_STATES:
        raise ValueError("invalid task outcome status")
    if not isinstance(outcome.get("summary"), str) or not 1 <= len(outcome["summary"]) <= 500:
        raise ValueError("invalid task outcome summary")
    for field in ("artifacts", "checks"):
        if not isinstance(outcome.get(field), list) or len(outcome[field]) > 32:
            raise ValueError(f"invalid task outcome {field}")
    for artifact in outcome["artifacts"]:
        if (not isinstance(artifact, dict) or set(artifact) != {"type", "ref"}
                or artifact.get("type") not in {"pr", "file", "report", "test"}
                or not isinstance(artifact.get("ref"), str) or not 1 <= len(artifact["ref"]) <= 300):
            raise ValueError("invalid task outcome artifact")
    for check in outcome["checks"]:
        if (not isinstance(check, dict) or set(check) != {"name", "status"}
                or not isinstance(check.get("name"), str) or not 1 <= len(check["name"]) <= 100
                or check.get("status") not in {"pass", "fail"}):
            raise ValueError("invalid task outcome check")
    return outcome


def validate_pr_artifacts(outcome, envelope, client):
    validations = []
    pattern = re.compile(r"^(?:https://github\.com/([^/]+/[^/]+)/pull/|#)([1-9][0-9]*)$")
    expected_branch = EXPECTED_BRANCH_PREFIX + envelope['task_id']
    for artifact in outcome["artifacts"]:
        if artifact["type"] != "pr":
            continue
        match = pattern.fullmatch(artifact["ref"])
        if not match or (match.group(1) and match.group(1) != envelope["source_repository"]):
            raise ValueError("invalid pull request reference")
        pr = client.pull_request(envelope["source_repository"], int(match.group(2)))
        if (pr.get("base", {}).get("ref") != "main"
                or pr.get("head", {}).get("ref") != expected_branch
                or pr.get("base", {}).get("repo", {}).get("full_name") != envelope["source_repository"]):
            raise ValueError("pull request is not bound to expected repository or branch")
        validations.append(f"pr:{match.group(2)}:repository_branch_base")
    return validations


def admitted_record(run_dir, envelope):
    state_dir = run_dir.parents[2]
    matches = list((state_dir / "inbox").glob(f"*__{envelope['source_issue']}__{envelope['source_sha256']}.json"))
    if len(matches) != 1:
        raise ValueError("immutable inbox admission record missing")
    record = json.loads(matches[0].read_text(encoding="utf-8"))
    expected = {"repository": envelope["source_repository"],
                "issue_number": envelope["source_issue"],
                "source_sha256": envelope["source_sha256"],
                "author_login": envelope["author"]}
    if any(record.get(key) != value for key, value in expected.items()):
        raise ValueError("inbox admission record mismatch")
    return record


def verify_source(envelope, issue, watcher, record):
    metadata, rejection = watcher.validate(envelope["source_repository"], issue)
    if rejection:
        raise ValueError(f"source no longer authorized: {rejection}")
    # GitHub may advance Issue.updatedAt when this reporter appends a comment. The admitted
    # timestamp is therefore restored before hashing; every content-bearing source field is
    # still taken from the fresh fetch and must remain byte-for-byte bound to admission.
    digest_issue = dict(issue)
    digest_issue["updatedAt"] = record["updated_at"]
    normalized = watcher.normalized_payload(envelope["source_repository"], digest_issue)
    digest = hashlib.sha256(normalized.encode("utf-8")).hexdigest()
    if digest != envelope["source_sha256"] or issue["number"] != envelope["source_issue"]:
        raise ValueError("source digest or issue mismatch")
    if metadata.get("id") != envelope["task_id"] or metadata.get("agent") != envelope["agent"]:
        raise ValueError("source metadata mismatch")


def receipt_payload(state, envelope, claim, result, run_dir, outcome=None, validations=None):
    values = {"task_id": envelope["task_id"], "agent": envelope["agent"],
              "source_sha256": envelope["source_sha256"], "lease_id": envelope["lease_id"]}
    if state == "CLAIMED":
        values["claimed_at"] = claim["claimed_at"]
        fields = (*COMMON_FIELDS, "claimed_at")
    elif state in EXECUTION_STATES.values():
        values.update({"started_at": result["started_at"], "finished_at": result["finished_at"],
                       "exit_status": result.get("process_exit_status"),
                       "stdout_sha256": result["stdout_sha256"],
                       "stderr_sha256": result["stderr_sha256"],
                       "result_sha256": file_sha256(run_dir / "result.json")})
        fields = (*COMMON_FIELDS, *EXECUTION_FIELDS)
    else:
        values.update({"outcome_status": outcome["status"],
                       "artifact_count": len(outcome["artifacts"]),
                       "check_count": len(outcome["checks"]),
                       "outcome_sha256": file_sha256(run_dir / "task-outcome.json"),
                       "evidence_validation": json.dumps(validations, separators=(",", ":"))})
        fields = (*COMMON_FIELDS, *TASK_FIELDS)
    key_source = f"{values['source_sha256']}\n{values['lease_id']}\n{state}"
    receipt_key = "sha256:" + hashlib.sha256(key_source.encode("ascii")).hexdigest()
    lines = ["<!-- chitakasha-receipt:v1 -->", state, ""]
    for field in fields:
        value = values[field]
        lines.append(f"{field}: {'null' if value is None else value}")
    lines.append(f"receipt_key: {receipt_key}")
    return "\n".join(lines) + "\n", receipt_key


def write_validation_record(run_dir, envelope, outcome, receipt_state, receipt_key,
                            validations, remote, validation_timestamp):
    """Persist only bounded, evidence-oriented fields; never copy worker content."""
    payload = {
        "protocol": VALIDATION_PROTOCOL,
        "reporter_authority": REPORTER_AUTHORITY,
        "reporter_protocol": REPORTER_PROTOCOL,
        "reporter_sha256": file_sha256(Path(__file__)),
        "task_id": envelope["task_id"],
        "source_sha256": envelope["source_sha256"],
        "lease_id": envelope["lease_id"],
        "issue_number": envelope["source_issue"],
        "outcome_status": outcome["status"],
        "outcome_sha256": file_sha256(run_dir / "task-outcome.json"),
        "terminal_receipt_state": receipt_state,
        "receipt_key": receipt_key,
        "evidence_validation": list(validations),
        "validation_timestamp": validation_timestamp,
        "validation_timestamp_source": "result.finished_at",
        "remote_state": remote,
    }
    canonical = json.dumps(payload, sort_keys=True, separators=(",", ":"))
    payload["payload_sha256"] = hashlib.sha256(canonical.encode("utf-8")).hexdigest()
    path = run_dir / "writeback" / "validation-record.json"
    if path.exists():
        existing = json.loads(path.read_text(encoding="utf-8"))
        if existing != payload:
            raise ValueError("conflicting validation record")
        return "already_recorded"
    try:
        write_exclusive(path, payload)
    except FileExistsError:
        existing = json.loads(path.read_text(encoding="utf-8"))
        if existing != payload:
            raise ValueError("conflicting validation record")
        return "already_recorded"
    return "recorded"


def load_terminal_marker(path, receipt_state, receipt_key):
    """Validate the producer's local marker before it can authorize a record."""
    marker = json.loads(path.read_text(encoding="utf-8"))
    if not isinstance(marker, dict) or set(marker) != MARKER_KEYS:
        raise ValueError("invalid terminal marker schema")
    if marker.get("state") != receipt_state or marker.get("receipt_key") != receipt_key:
        raise ValueError("terminal marker provenance mismatch")
    remote = marker.get("remote")
    if remote not in MARKER_REMOTE:
        raise ValueError("invalid terminal marker remote")
    return MARKER_REMOTE[remote]


def report(run_dir, state, client=None, watcher=None):
    if state not in {"CLAIMED", "TASK_OUTCOME", *EXECUTION_STATES.values()}:
        raise ValueError("unsupported receipt state")
    client = client or GhClient()
    watcher = watcher or load_watcher()
    envelope, claim, result = load_bound_run(run_dir, state)
    record = admitted_record(run_dir, envelope)
    issue = client.issue(envelope["source_repository"], envelope["source_issue"])
    verify_source(envelope, issue, watcher, record)
    outcome = validations = None
    receipt_state = state
    if state == "TASK_OUTCOME":
        if result.get("terminal_state") != "execution_finished" or result.get("process_exit_status") != 0:
            raise ValueError("task outcome requires successful process execution")
        outcome = load_outcome(run_dir, envelope)
        validations = validate_pr_artifacts(outcome, envelope, client)
        receipt_state = TASK_STATES[outcome["status"]]
    body, receipt_key = receipt_payload(receipt_state, envelope, claim, result, run_dir,
                                        outcome, validations)
    marker = run_dir / "writeback" / f"{receipt_state.lower()}.json"
    if marker.exists():
        remote_state = load_terminal_marker(marker, receipt_state, receipt_key)
        if state == "TASK_OUTCOME":
            write_validation_record(run_dir, envelope, outcome, receipt_state, receipt_key,
                                    validations, remote_state,
                                    result["finished_at"])
        return "already_reported"
    comments = client.comments(envelope["source_repository"], envelope["source_issue"])
    # Remote publication is proven only by the complete canonical body.
    # Substring matching accepts copied keys, quoted fragments, and conflicts.
    if any(isinstance(comment, dict) and comment.get("body") == body for comment in comments):
        write_exclusive(marker, {"receipt_key": receipt_key, "state": receipt_state, "remote": "existing"})
        if state == "TASK_OUTCOME":
            write_validation_record(run_dir, envelope, outcome, receipt_state, receipt_key,
                                    validations, "confirmed-existing", result["finished_at"])
        return "already_reported"
    client.post(envelope["source_repository"], envelope["source_issue"], body)
    write_exclusive(marker, {"receipt_key": receipt_key, "state": receipt_state, "remote": "posted"})
    if state == "TASK_OUTCOME":
        write_validation_record(run_dir, envelope, outcome, receipt_state, receipt_key,
                                validations, "posted", result["finished_at"])
    return "posted"


def record_failure(run_dir, state, exc):
    path = run_dir / "writeback" / f"{state.lower()}.failure.json"
    try:
        write_exclusive(path, {"state": state, "error_type": type(exc).__name__})
    except FileExistsError:
        pass


def main():
    parser = argparse.ArgumentParser()
    parser.add_argument("--run-dir", type=Path, required=True)
    parser.add_argument("--state", required=True)
    args = parser.parse_args()
    try:
        print(report(args.run_dir, args.state))
        return 0
    except Exception as exc:
        record_failure(args.run_dir, args.state, exc)
        print(f"reporter: {type(exc).__name__}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    raise SystemExit(main())
