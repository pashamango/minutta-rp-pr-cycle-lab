{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mindrock.capital/schemas/vhp-manifest-v1.json",
  "title": "VHP One-Click Submission Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "manifest_id", "revision", "state", "source", "artifacts", "verification", "approval", "submission"],
  "properties": {
    "schema": {"const": "vhp-manifest/v1"},
    "manifest_id": {"type": "string", "pattern": "^vhp-[a-z0-9][a-z0-9-]*$"},
    "revision": {"type": "integer", "minimum": 1},
    "state": {"enum": ["prepared", "validated", "awaiting_approval", "submitted", "reconciled", "blocked"]},
    "source": {
      "type": "object", "additionalProperties": false,
      "required": ["linear", "github"],
      "properties": {
        "linear": {"type": "object", "additionalProperties": false, "required": ["issue_id", "issue_url"], "properties": {"issue_id": {"type": "string", "pattern": "^[A-Z]+-[0-9]+$"}, "issue_url": {"type": "string", "format": "uri"}, "project_id": {"type": "string"}}},
        "drive": {"type": "object", "additionalProperties": false, "required": ["file_id"], "properties": {"file_id": {"type": "string"}, "mime_type": {"type": "string"}, "source_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}},
        "github": {"type": "object", "additionalProperties": false, "required": ["repo", "ref", "commit_sha", "tree_sha"], "properties": {"repo": {"type": "string", "pattern": "^[^/]+/[^/]+$"}, "ref": {"type": "string", "minLength": 1}, "commit_sha": {"type": "string", "pattern": "^[a-f0-9]{40}$"}, "tree_sha": {"type": "string", "pattern": "^[a-f0-9]{40}$"}}}
      }
    },
    "artifacts": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["path", "sha256", "kind"], "properties": {"path": {"type": "string", "pattern": "^(?!/)(?!.*\\.\\.).+"}, "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "kind": {"enum": ["source", "evidence", "documentation", "receipt"]}}}},
    "verification": {"type": "object", "additionalProperties": false, "required": ["command", "clean_checkout"], "properties": {"command": {"type": "string", "minLength": 1}, "clean_checkout": {"type": "boolean", "const": true}}},
    "approval": {"type": "object", "additionalProperties": false, "required": ["required", "merge_allowed"], "properties": {"required": {"type": "boolean", "const": true}, "merge_allowed": {"type": "boolean", "const": false}, "approved_by": {"type": ["string", "null"]}}},
    "submission": {"type": "object", "additionalProperties": false, "required": ["idempotency_key", "target", "mode"], "properties": {"idempotency_key": {"type": "string", "minLength": 16}, "target": {"enum": ["github_pull_request"]}, "mode": {"enum": ["create_or_update"]}, "pull_request_number": {"type": ["integer", "null"], "minimum": 1}}}
  }
}
