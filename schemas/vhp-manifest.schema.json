{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mindrock.capital/schemas/vhp-manifest.schema.json",
  "title": "VHP one-click submission manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["manifestVersion", "submissionId", "createdAt", "expiresAt", "project", "sources", "artifacts", "policy"],
  "properties": {
    "manifestVersion": {"const": "1.0"},
    "submissionId": {"type": "string", "pattern": "^vhp-[A-Za-z0-9][A-Za-z0-9._-]{7,127}$"},
    "createdAt": {"type": "string", "format": "date-time"},
    "expiresAt": {"type": "string", "format": "date-time"},
    "project": {
      "type": "object", "additionalProperties": false, "required": ["id", "name"],
      "properties": {"id": {"type": "string", "minLength": 1}, "name": {"type": "string", "minLength": 1}, "ticketId": {"type": "string", "pattern": "^[A-Z][A-Z0-9]+-[0-9]+$"}}
    },
    "sources": {
      "type": "object", "additionalProperties": false, "required": ["drive", "linear", "github"],
      "properties": {
        "drive": {"$ref": "#/$defs/drive"},
        "linear": {"$ref": "#/$defs/linear"},
        "github": {"$ref": "#/$defs/github"}
      }
    },
    "artifacts": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/artifact"}},
    "policy": {
      "type": "object", "additionalProperties": false, "required": ["humanApprovalRequired", "autoMerge", "allowedHosts"],
      "properties": {"humanApprovalRequired": {"const": true}, "autoMerge": {"const": false}, "allowedHosts": {"type": "array", "minItems": 3, "uniqueItems": true, "items": {"type": "string", "enum": ["drive.google.com", "linear.app", "github.com"]}}}
    },
    "integrity": {"type": "object", "additionalProperties": false, "properties": {"manifestSha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "driveSha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}}
  },
  "$defs": {
    "drive": {"type": "object", "additionalProperties": false, "required": ["fileId", "webUrl"], "properties": {"fileId": {"type": "string", "minLength": 1}, "webUrl": {"type": "string", "format": "uri", "pattern": "^https://drive\\.google\\.com/"}}},
    "linear": {"type": "object", "additionalProperties": false, "required": ["issueId", "issueUrl", "state"], "properties": {"issueId": {"type": "string", "pattern": "^[A-Z][A-Z0-9]+-[0-9]+$"}, "issueUrl": {"type": "string", "format": "uri", "pattern": "^https://linear\\.app/"}, "state": {"type": "string", "enum": ["In Progress", "In Review"]}}},
    "github": {"type": "object", "additionalProperties": false, "required": ["repoUrl", "branch", "commitSha"], "properties": {"repoUrl": {"type": "string", "format": "uri", "pattern": "^https://github\\.com/[^/]+/[^/]+(?:\\.git)?$"}, "branch": {"type": "string", "pattern": "^[A-Za-z0-9._/-]+$"}, "commitSha": {"type": "string", "pattern": "^[a-f0-9]{40}$"}}},
    "artifact": {"type": "object", "additionalProperties": false, "required": ["path", "sha256"], "properties": {"path": {"type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+"}, "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "mediaType": {"type": "string"}}}
  }
}
